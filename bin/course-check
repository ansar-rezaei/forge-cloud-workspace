#!/usr/bin/env bash
# Checks the general setup from the course: Node.js, the Forge CLI and your login.
#   course-check
set -uo pipefail

ok=0
pass() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$1"; shift; printf '    %s\n' "$@"; ok=1; }

echo "Forge Cloud setup"

node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$node_major" -ge 22 ]; then pass "Node.js $(node --version)"
else fail "Node.js 22 or newer" "Found: $(node --version 2>/dev/null || echo none)."; fi

# The CLI is only working if it can print its own version. It refuses to start on a Node.js
# it doesn't support, and then nothing after this line can work either.
cli_ok=0
if ! command -v forge >/dev/null; then
  fail "Forge CLI" "It isn't installed. Install it: npm install -g @forge/cli@latest"
elif version="$(forge --version 2>&1)"; then
  pass "Forge CLI $(echo "$version" | grep -v '^\s*$' | tail -1)"
  cli_ok=1
elif grep -q 'Unsupported Node.js version' <<<"$version"; then
  fail "Forge CLI" \
    "It won't start: this Node.js ($(node --version)) is older than the CLI accepts." \
    "Fix it with: nvm install 24" \
    "Then open a new terminal and run course-check again."
else
  fail "Forge CLI" "It won't start. It said:" "$(echo "$version" | grep -v '^\s*$' | head -1)"
fi

if [ "$cli_ok" -eq 0 ]; then
  fail "Logged in" "Not checked: the Forge CLI has to work first."
elif [ -z "${FORGE_EMAIL:-}" ] || [ -z "${FORGE_API_TOKEN:-}" ]; then
  fail "Logged in" "Run course-login, or save FORGE_EMAIL and FORGE_API_TOKEN as Codespaces secrets."
elif who="$(forge whoami 2>&1)"; then
  pass "Logged in: $(echo "$who" | grep -v '^\s*$' | tail -1)"
elif [ -f "$HOME/.forge-login" ]; then
  fail "Logged in" \
    "The CLI refused the email or token you saved with course-login. The token may be mistyped or expired." \
    "Create a new token, then run course-login again."
else
  fail "Logged in" \
    "The CLI refused the FORGE_EMAIL or FORGE_API_TOKEN Codespaces secret. The token may be expired." \
    "Create a new token and run course-login with it, or update the secret at" \
    "https://github.com/settings/codespaces and restart the codespace."
fi

if [ "$ok" -eq 0 ]; then
  echo "All set. Next: get a developer site, as in the course's general setup."
fi
exit "$ok"
